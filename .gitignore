# Build output
build/
*.elf
*.bin
*.map
*.o

# Python
.venv/
venv/
__pycache__/
*.pyc

# Renode / Robot Framework test output
robot_output.xml
log.html
report.html
*.robot.log
logs/
snapshots/

# renode/ holds this project's own peripheral scripts, nothing else. A Renode
# installation must never be unpacked there: the CI cache once covered that
# directory and restored a stale copy of sensor.py over the checkout. CI now
# installs Renode outside the workspace entirely, and a CI step fails the build
# if anything modifies tracked files after checkout - which is a real guard,
# unlike the partial ignore list that used to sit here.
/renode-dist/

# Secrets and credentials - nothing here is expected to exist, these are a
# backstop so an accidental file cannot be committed without noticing.
.env
.env.*
*.env
secrets.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc
.npmrc
credentials.json
service-account*.json

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
